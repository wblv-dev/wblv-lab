#!/usr/bin/env bash
# labctl — READ-ONLY access to the WBLV lab. Creds live in a dedicated 1Password vault (auto-detected: the
# single vault the service account can see). That vault holds ONLY lab hosts, so discovery is naturally scoped.
#   labctl hosts                 list lab hosts (from 1Password) + type + reachability
#   labctl opnsense <api/path>   GET an OPNsense read-only API endpoint (default: core/firmware/status)
#   labctl nas shares            list readable NAS shares
#   labctl nas ls <folder>       list a NAS folder (read-only)
#   labctl switch "<show cmd>"   run an Aruba operator (show-only) command
#   labctl help
set -uo pipefail
TF="$HOME/.config/wblv/op-token"
[ -s "$TF" ] || { echo "labctl: no op token at $TF" >&2; exit 1; }
export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$TF")"
V="$(op vault list --format json 2>/dev/null | jq -r '.[0].name // empty')"
[ -n "$V" ] || { echo "labctl: service account sees no vault" >&2; exit 1; }
HELP(){ grep -E '^#( |$)' "$0" | sed 's/^# \{0,1\}//'; }
item_id(){ op item list --vault "$V" --format json 2>/dev/null | jq -r --arg re "$1" '.[]|select(.title|test($re;"i"))|.id' | head -1; }
field(){ op item get "$1" --vault "$V" --fields "$2" --reveal 2>/dev/null; }
item_url(){ op item get "$1" --vault "$V" --format json 2>/dev/null | jq -r '(.urls//[]|map(.href)|join(","))'; }

# Resolve a host from its 1Password item URL into $HOST. NEVER substitutes a guess.
#
# A fallback host is a silent wrong answer, and this tool exists precisely so that it cannot be
# wrong. If an item has no URL that is a data fault in 1Password, and it must be visible rather
# than papered over: an error names the fault, a fallback sends you debugging the wrong host.
# (This replaced a fallback to 10.19.0.177 — the switch's LAN address, dead since 2026-07-08 —
# which would have "worked" right up until it silently didn't.)
#
# Called directly, never inside $(...): `exit` in a command substitution only kills the subshell.
resolve_host(){
  HOST="$(item_url "$1" | sed -E 's#https?://##;s#[/,].*##;s#:.*##' | head -1)"
  [ -n "$HOST" ] || { echo "labctl: 1Password item for '$2' has no URL — cannot resolve a hostname." >&2
                      echo "        Add the host URL to that item. labctl will not guess an address." >&2; exit 1; }
}

cmd="${1:-help}"; shift || true
case "$cmd" in
hosts)
  exec python3 "$HOME/.config/wblv/lab_discover.py" "$@"
  ;;
opnsense|opn)
  id="$(item_id 'OPN')"; [ -n "$id" ] || { echo "no OPNsense creds in vault" >&2; exit 1; }
  # Hostname, never an IP (standard #3). The old numeric-IP grep + hardcoded ADM fallback is
  # obsolete: lab-9 repointed opn-01.wblv.uk to the ADM address on 2026-07-24, so the name now
  # resolves to the interface mac-01 can actually reach. Addressing by name is also what lets TLS
  # be verified for real — the LE wildcard is valid for the hostname and can never match a bare IP,
  # which is the only reason this call previously needed -k.
  resolve_host "$id" opnsense
  K="$(field "$id" label=Key)"; K="${K#key=}"; S="$(field "$id" label=Secret)"; S="${S#secret=}"
  curl -s -u "$K:$S" --max-time 15 "https://${HOST}/api/${1:-core/firmware/status}"
  ;;
nas)
  id="$(item_id 'NAS')"; [ -n "$id" ] || { echo "no NAS creds in vault" >&2; exit 1; }
  U="$(field "$id" label=username)"; P="$(field "$id" label=password)"; [ -n "$P" ] || P="$(field "$id" label=confirmpassword)"
  # Host from the 1Password item URL (hostname, never an IP — standard #3). No fallback: see
  # resolve_host. NB DSM keeps -k below because it still presents a self-signed cert
  # (ssl_verify_result=20); drop the -k once lab-9's remainder redeploys the wildcard there.
  resolve_host "$id" nas
  B="https://${HOST}:5001/webapi"
  auth(){ curl -sk -G "$B/entry.cgi" --data-urlencode api=SYNO.API.Auth --data-urlencode version=7 "$@" --max-time 15; }
  SID="$(auth --data-urlencode method=login --data-urlencode account="$U" --data-urlencode passwd="$P" --data-urlencode session=FileStation --data-urlencode format=sid | jq -r '.data.sid//empty')"
  [ -n "$SID" ] || { echo "NAS login failed" >&2; exit 1; }
  fs(){ curl -sk -G "$B/entry.cgi" --data-urlencode api=SYNO.FileStation.List --data-urlencode version=2 "$@" --data-urlencode _sid="$SID" --max-time 12; }
  case "${1:-shares}" in
    shares) fs --data-urlencode method=list_share --data-urlencode additional=perm | jq -r '.data.shares[]?|"  "+.name+"  ("+.path+")  read="+((.additional.perm.acl.read)|tostring)+" write="+((.additional.perm.acl.write)|tostring)';;
    ls) fs --data-urlencode method=list --data-urlencode folder_path="${2:-/}" --data-urlencode 'additional=["size","time"]' \
          | jq -r 'def hsz: if .==null then "-" elif .<1024 then "\(.)B" elif .<1048576 then "\((./1024)|floor)K" elif .<1073741824 then "\((./1048576)|floor)M" else "\((((./1073741824)*10)|floor)/10)G" end;
                   def rpad($w): . + (" " * ([$w - length, 1] | max));
                   .data.files[]?
                     | (((if .isdir then "[d] " else "    " end) + .name) | rpad(48)) as $n
                     | ((if .isdir then "-" else (.additional.size|hsz) end) | rpad(9)) as $sz
                     | ((.additional.time.mtime // 0) | if .==0 then "-" else (localtime|strftime("%Y-%m-%d %H:%M")) end) as $mt
                     | "  " + $n + $sz + $mt';;
    *) echo "usage: labctl nas {shares|ls <folder>}" >&2;;
  esac
  auth --data-urlencode method=logout --data-urlencode session=FileStation --data-urlencode _sid="$SID" >/dev/null 2>&1
  ;;
switch|sw)
  id="$(item_id 'SWT')"; [ -n "$id" ] || { echo "no switch creds in vault" >&2; exit 1; }
  # SSH user comes from the item. No fallback to 'operator': the 2026-07-09 account model removed
  # the anonymous operator login, so that fallback now yields an auth failure that looks like a
  # switch problem instead of the missing-field problem it actually is.
  U="$(field "$id" label=username)"
  [ -n "$U" ] || { echo "labctl: 1Password switch item has no 'username' field." >&2; exit 1; }
  export SWT_PW="$(field "$id" label=password)"; [ -n "$SWT_PW" ] || export SWT_PW="$(field "$id" 'label=Operator Password')"
  resolve_host "$id" switch
  "$HOME/.config/wblv/switch_show.py" "$HOST" "$U" "${@:-show system}"
  ;;
help|--help|-h|*) HELP;;
esac
