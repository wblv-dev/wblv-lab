#!/usr/bin/env bash
# labctl — READ-ONLY control plane for the WBLV lab.
# Inventory: OPNsense (authoritative IPAM). Credentials: a dedicated read-only 1Password vault.
# Usage text lives in HELP() below — do NOT restate it here, or the two will drift.
set -uo pipefail
TF="$HOME/.config/wblv/op-token"
[ -s "$TF" ] || { echo "labctl: no op token at $TF" >&2; exit 1; }
export OP_SERVICE_ACCOUNT_TOKEN="$(cat "$TF")"
V="$(op vault list --format json 2>/dev/null | jq -r '.[0].name // empty')"
[ -n "$V" ] || { echo "labctl: service account sees no vault" >&2; exit 1; }
# Usage is an explicit block, NOT scraped from comments. The previous version grepped every
# column-0 comment in this file, so any explanatory comment added later silently became help
# text — which is how two internal design notes ended up printed to users.
HELP(){ cat <<'USAGE'
labctl — READ-ONLY access to the WBLV lab.

Inventory comes from OPNsense (the authoritative IPAM); credentials from a dedicated,
read-only 1Password vault holding only lab hosts. Every path is a GET / show / read-only
login: labctl can look, never touch. Device changes are done by hand, deliberately.

  labctl hosts                 inventory + reach/auth/drift — run this first
  labctl hosts <host>          detail for one host

  labctl <host> ?              ask that host what it can answer
  labctl <host> <query>        run one of them

  labctl help                  this text

labctl is a live view, not a wrapper. It holds no catalogue of its own: `?` asks the
device, and a query is the device's OWN interface — an OPNsense API path, a DSM
API call, an Aruba operator command, a shell command. Their documentation is the
documentation. Nothing here can go stale, because nothing here is remembered.

Hosts accept any form you have: opn-01, WBLV-OPN-01, or opn-01.wblv.uk.
A host is an ARGUMENT, not a command — adding a device adds a role handler, not a verb.

Exit codes: 0 ok · 1 fault (creds, host, or device error) · 2 usage error
USAGE
}
item_id(){ op item list --vault "$V" --format json 2>/dev/null | jq -r --arg re "$1" '.[]|select(.title|test($re;"i"))|.id' | head -1; }
field(){ op item get "$1" --vault "$V" --fields "$2" --reveal 2>/dev/null; }
item_url(){ op item get "$1" --vault "$V" --format json 2>/dev/null | jq -r '(.urls//[]|map(.href)|join(","))'; }

# Resolve a host from its 1Password item URL into $HOST. NEVER substitutes a guess.
#
# A fallback host is a silent wrong answer, and this tool exists precisely so that it cannot be
# wrong. If an item has no URL that is a data fault in 1Password, and it must be visible rather
# than papered over: an error names the fault, a fallback sends you debugging the wrong host.
# (This replaced a fallback to 10.19.0.177 — the switch's LAN address, dead since 2026-07-08 —
# which would have "worked" right up until it silently didn't.)
#
# Called directly, never inside $(...): `exit` in a command substitution only kills the subshell.
resolve_host(){
  HOST="$(item_url "$1" | sed -E 's#https?://##;s#[/,].*##;s#:.*##' | head -1)"
  [ -n "$HOST" ] || { echo "labctl: 1Password item for '$2' has no URL — cannot resolve a hostname." >&2
                      echo "        Add the host URL to that item. labctl will not guess an address." >&2; exit 1; }
}

LD="$HOME/.config/wblv/lab_discover.py"

# --- per-role query handlers -------------------------------------------------------------------
# ONBOARDING A NEW HOST — four steps, no new top-level command, ever:
#   1. add its hostname prefix + ROLE_PROFILE entry to the role model in lab_discover.py
#   2. add a q_<role> handler below
#   3. wire it into the role dispatch at the bottom
#   4. create a `WBLV-<HOST> / CLAUDE` read-only item in 1Password with the host URL set
# Inventory, reachability and the command surface all follow from those. That is the whole point
# of dispatching on a hostname argument rather than adding a verb per device.
#
# $ITEM = the resolved 1Password item id, $HOSTQ = the short hostname as resolved. Both are set
# by the dispatcher before a handler runs, so a handler can never target a different host than
# the one that was asked for.

q_opnsense(){
  resolve_host "$ITEM" "$HOSTQ"
  K="$(field "$ITEM" label=Key)"; K="${K#key=}"; S="$(field "$ITEM" label=Secret)"; S="${S#secret=}"
  api(){ curl -s -u "$K:$S" --max-time 20 "https://${HOST}/api/$1"; }
  if [ -z "${1:-}" ] || [ "$1" = "?" ] || [ "$1" = "help" ] || [ "$1" = "--help" ]; then
    # OPNsense publishes NO machine-readable API catalogue: /api/openapi and /api/core/api/list
    # both 404, and core/menu/search returns GUI page URLs (/ui/...), not API paths. Say so
    # rather than inventing a list — a hand-kept catalogue is exactly the stale note this tool
    # exists to avoid. What the device CAN tell us is which plugins are installed, and each
    # plugin contributes an API module.
    echo "$HOSTQ (opnsense) does not publish an API catalogue — this is a device limitation."
    echo
    echo "  path shape   <module>/<controller>/<command>"
    echo "  docs         https://docs.opnsense.org/development/api.html"
    echo "  example      labctl $HOSTQ diagnostics/firewall/log"
    echo
    # MUST filter on installed=="1": core/firmware/info returns the whole REPOSITORY (930
    # packages here), not what is running. Reporting the repo as "installed" would be a
    # confidently wrong answer, which is worse than no answer.
    echo "  plugin API modules INSTALLED on this device (installed=1, live):"
    api core/firmware/info \
      | jq -r '[.package[]?|select(.installed=="1" and (.name|startswith("os-")))|.name|sub("^os-";"")]|sort|unique|join(" ")' 2>/dev/null \
      | fold -sw 74 | sed 's/^/    /'
    echo "  (plus the built-in core modules: core, diagnostics, firewall, interfaces, routes,"
    echo "   unbound, dnsmasq, ipsec, openvpn, cron, auth, captiveportal, monit, syslog)"
    return 0
  fi
  api "$1"
}

q_synology(){
  U="$(field "$ITEM" label=username)"; P="$(field "$ITEM" label=password)"
  [ -n "$P" ] || P="$(field "$ITEM" label=confirmpassword)"
  resolve_host "$ITEM" "$HOSTQ"
  # DSM keeps -k: still a self-signed cert (verified ssl_verify_result=20) until lab-9's
  # remainder redeploys the wildcard there.
  B="https://${HOST}:5001/webapi"
  SID="$(curl -sk -G "$B/entry.cgi" --max-time 20 --data-urlencode api=SYNO.API.Auth \
        --data-urlencode version=7 --data-urlencode method=login --data-urlencode account="$U" \
        --data-urlencode passwd="$P" --data-urlencode session=FileStation --data-urlencode format=sid \
        | jq -r '.data.sid//empty')"
  [ -n "$SID" ] || { echo "labctl: $HOSTQ login failed (DSM rejected the read-only credential)" >&2; exit 1; }
  trap 'curl -sk -G "$B/entry.cgi" --data-urlencode api=SYNO.API.Auth --data-urlencode version=7 \
        --data-urlencode method=logout --data-urlencode session=FileStation --data-urlencode _sid="$SID" \
        >/dev/null 2>&1' EXIT

  # The catalogue IS the documentation — the device advertises every API it serves, with the
  # version range it accepts. Nothing here is a wrapper: no invented verbs, no curated subset.
  CAT="$(curl -sk -G "$B/query.cgi" --max-time 20 --data-urlencode api=SYNO.API.Info \
        --data-urlencode version=1 --data-urlencode method=query --data-urlencode query=all)"

  if [ -z "${1:-}" ] || [ "$1" = "?" ] || [ "$1" = "help" ] || [ "$1" = "--help" ]; then
    filter="${2:-}"
    echo "$HOSTQ (synology) — APIs advertised by the device itself:"
    echo
    printf '%s' "$CAT" | jq -r --arg f "$filter" '
      .data | to_entries
      | map(select($f == "" or (.key|test($f;"i"))))
      | sort_by(.key)[]
      | "  \(.key)  [v\(.value.minVersion)-\(.value.maxVersion)]"' 2>/dev/null
    echo
    total="$(printf '%s' "$CAT" | jq -r '.data|length' 2>/dev/null)"
    echo "  $total APIs advertised. Filter with: labctl $HOSTQ help <pattern>"
    echo "  (zsh globs a bare ? — use 'help', or quote it: labctl $HOSTQ '?')"
    echo "  Call one with:  labctl $HOSTQ <API>/<method> [key=value ...]"
    echo "  Methods and parameters are documented by Synology, not by labctl."
    return 0
  fi

  # <API>/<method> — version resolved from the live catalogue so it can never be a stale guess.
  A="${1%%/*}"; M="${1#*/}"
  [ "$A" != "$1" ] || { echo "labctl: query must be <API>/<method>, e.g. SYNO.FileStation.List/list_share" >&2
                        echo "        Run 'labctl $HOSTQ ?' to list what this device advertises." >&2; exit 2; }
  VER="$(printf '%s' "$CAT" | jq -r --arg a "$A" '.data[$a].maxVersion // empty')"
  [ -n "$VER" ] || { echo "labctl: $HOSTQ does not advertise an API called '$A'." >&2
                     echo "        Run 'labctl $HOSTQ ? ${A%%.*}' to see what it does advertise." >&2; exit 1; }
  shift
  set -- "$@"; extra=()
  for kv in "$@"; do extra+=(--data-urlencode "$kv"); done
  curl -sk -G "$B/entry.cgi" --max-time 20 --data-urlencode api="$A" --data-urlencode version="$VER" \
       --data-urlencode method="$M" --data-urlencode _sid="$SID" "${extra[@]+"${extra[@]}"}"
}

q_aruba_switch(){
  U="$(field "$ITEM" label=username)"
  [ -n "$U" ] || { echo "labctl: 1Password item for $HOSTQ has no 'username' field." >&2; exit 1; }
  export SWT_PW="$(field "$ITEM" label=password)"
  [ -n "$SWT_PW" ] || export SWT_PW="$(field "$ITEM" 'label=Operator Password')"
  resolve_host "$ITEM" "$HOSTQ"
  # ArubaOS answers a bare '?' with the commands available AT THE CURRENT PRIVILEGE LEVEL, so the
  # capability list is both device-sourced and correctly scoped — operator sees only show-only
  # commands. ('show ?' is rejected; the bare form is the one that enumerates.)
  q="${*:-?}"
  case "$q" in help|--help) q="?";; esac
  [ "$q" != "?" ] || echo "$HOSTQ (aruba-switch) — commands available to this operator login:"
  "$HOME/.config/wblv/switch_show.py" "$HOST" "$U" "$q"
}

q_raspberry_pi(){
  U="$(field "$ITEM" label=username)"; U="${U#username=}"
  P="$(field "$ITEM" label=password)"; [ -n "$P" ] || P="$(field "$ITEM" label=confirmpassword)"
  P="${P#password=}"
  [ -n "$U" ] && [ -n "$P" ] || { echo "labctl: 1Password item for $HOSTQ is missing username/password." >&2; exit 1; }
  resolve_host "$ITEM" "$HOSTQ"
  sh(){ RPI_PW="$P" "$HOME/.config/wblv/rpi_show.py" "$HOST" "$U" "$1"; }
  if [ -z "${1:-}" ] || [ "$1" = "?" ] || [ "$1" = "help" ] || [ "$1" = "--help" ]; then
    # A shell has no catalogue, so the honest capability answer is what this ACCOUNT can do —
    # proven live, not asserted. sudo -n -l reports privilege without requiring any.
    echo "$HOSTQ (raspberry-pi) — a shell, so any read-only command. What this login can do:"
    echo
    echo "  account     $(sh 'id -un' 2>/dev/null | tail -1)  ($(sh 'id -Gn' 2>/dev/null | tail -1))"
    echo "  sudo        $(sh 'sudo -n -l 2>&1 | head -1' 2>/dev/null | tail -1)"
    echo "  os          $(sh '. /etc/os-release; echo $PRETTY_NAME' 2>/dev/null | tail -1)"
    echo
    echo "  running services this host actually has (device-reported):"
    sh "systemctl list-units --type=service --state=running --no-legend --no-pager | awk '{print \$1}' | sed 's/.service\$//'" 2>/dev/null \
      | tail -n +1 | paste -sd" " - | fold -sw 76 | sed 's/^/    /'
    echo
    echo "  Call one with:  labctl $HOSTQ \"<command>\"   e.g. \"systemctl is-active pihole-FTL\""
    return 0
  fi
  sh "$*"
}

# --- dispatch ----------------------------------------------------------------------------------
cmd="${1:-help}"; shift || true
case "$cmd" in
hosts)
  exec python3 "$LD" "$@"
  ;;
help|--help|-h|'?'|-\?)
  HELP
  ;;
*)
  # Not a facet, so treat it as a hostname. Accepts opn-01 / WBLV-OPN-01 / opn-01.wblv.uk.
  HOSTQ="$(printf '%s' "$cmd" | tr 'A-Z' 'a-z')"; HOSTQ="${HOSTQ%%.*}"; HOSTQ="${HOSTQ#wblv-}"
  ROLE="$(python3 "$LD" --roles | jq -r --arg p "${HOSTQ%%-*}" '.prefix[$p] // empty')"
  if [ -z "$ROLE" ]; then
    echo "labctl: no handler for '$cmd'." >&2
    echo "        It is not a command (hosts, help), and no device role is mapped to the" >&2
    echo "        prefix '${HOSTQ%%-*}'. Some hosts legitimately have none — mac-01 is the" >&2
    echo "        control node and dsk-01 is a workstation; neither exposes read-only mgmt." >&2
    echo "        Run 'labctl hosts' to see every host and its role." >&2
    exit 2
  fi
  # Resolve the vault item for THIS host by title (convention: WBLV-<HOST> [/ CLAUDE]). Matching
  # on the requested host — rather than on a role keyword — is what stops `labctl opn-99 ...`
  # silently querying opn-01 with opn-01's credentials.
  ITEM="$(item_id "^WBLV-${HOSTQ}([ /]|\$)")"
  if [ -z "$ITEM" ]; then
    echo "labctl: no read-only 1Password item for host '$HOSTQ'." >&2
    echo "        Expected an item titled 'WBLV-$(printf '%s' "$HOSTQ" | tr 'a-z' 'A-Z') / CLAUDE'." >&2
    echo "        Run 'labctl hosts' to see which hosts have credentials." >&2
    exit 1
  fi
  case "$ROLE" in
    # No default query is invented for a bare host: guessing one for the caller is a wrapper
    # by another name. `labctl <host>` is the same as `labctl <host> ?` — ask the device.
    opnsense)     q_opnsense "${@:-?}" ;;
    synology)     q_synology "${@:-?}" ;;
    aruba-switch) q_aruba_switch "${@:-?}" ;;
    raspberry-pi) q_raspberry_pi "${@:-?}" ;;
    tplink-ap)
      echo "labctl: $HOSTQ ($ROLE) has no read-only handler — the standalone AP exposes only a" >&2
      echo "        web UI. Superseded by the Omada controller (lab-74)." >&2
      exit 1 ;;
    *)
      echo "labctl: role '$ROLE' has no query handler yet. Add q_${ROLE//-/_}() in labctl." >&2
      exit 1 ;;
  esac
  ;;
esac
